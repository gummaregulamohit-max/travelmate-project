# SerpApi (Google Flights) — get a key at https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key
# Optional: true = SerpApi deep search (slower; closer to browser Google Flights results)
SERPAPI_DEEP_SEARCH=false

# Amadeus Self-Service credentials — no longer used by default (SerpApi is
# now the active flight-search provider) but left here in case you switch
# src/routes/flights.routes.js back to src/services/amadeus.service.js.
# Get free test credentials at https://developers.amadeus.com/register
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

PORT=3000

# Default train data provider: the "Indian Railway IRCTC" API on RapidAPI —
# verifies timetable trains and train schedules against live IRCTC data.
# Subscribe at https://rapidapi.com/rahilkhan224/api/indian-railway-irctc
# (free Basic plan: 50 requests/month) and paste your X-RapidAPI-Key here.
# Server-side only — never put it in public/. Without it, train search uses
# the public erail.in timetable alone.
RAPIDAPI_KEY=
RAPIDAPI_HOST=indian-railway-irctc.p.rapidapi.com
# Uncached IRCTC lookups one train search may spend (each is one request of
# the monthly quota). Blank = 3. 0 = none: searches use the timetable plus
# IRCTC data already cached; train schedule pop-ups still use IRCTC.
# Capped at 10; a value that isn't a whole number falls back to 3.
TRAIN_API_MAX_LOOKUPS_PER_SEARCH=
# Live IRCTC requests are OFF until you set this. The total number of IRCTC
# requests this server may ever send (search lookups and schedule pop-ups).
# Requests are counted in TRAIN_API_USAGE_FILE before they are sent and the
# server never resets the count. To allow more later, raise this number, or —
# after checking your quota on the RapidAPI dashboard — start a new local
# period with: npm run irctc:usage -- --reset --confirm (that does not renew
# RapidAPI's quota or lift a 403/429 block). `npm run irctc:usage` shows the
# count. Keep it within your plan (BASIC: 50 requests/month). Blank / 0 = off.
TRAIN_API_REQUEST_BUDGET=
# When your RapidAPI quota period starts — copy it from the RapidAPI dashboard
# (Billing / your subscription's renewal date), e.g. 2026-10-14 or
# 2026-10-14T05:30:00Z (UTC). The count above then restarts at 0 monthly from
# that date, and the manual reset is disabled. Restarting TravelMate's count is
# NOT taken as proof RapidAPI renewed: a 403/429 block or RapidAPI's own
# "0 requests left" still holds until RapidAPI's reset time. Blank = no
# automatic periods (the count restarts only by the manual reset).
TRAIN_API_QUOTA_RESET_DATE=
# Where that count, RapidAPI's last reported quota and any 403/429 block are
# kept. Default: .cache/irctc-usage.json in this folder. Several backend
# processes on one machine may share it — access is locked.
TRAIN_API_USAGE_FILE=
# How long a request waits for that lock before giving up (sending nothing).
# Default 5000 ms.
TRAIN_API_LOCK_TIMEOUT_MS=
