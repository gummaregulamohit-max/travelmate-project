# SerpApi (Google Flights) — get a key at https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key

# Amadeus Self-Service credentials — no longer used by default (SerpApi is
# now the active flight-search provider) but left here in case you switch
# src/routes/flights.routes.js back to src/services/amadeus.service.js.
# Get free test credentials at https://developers.amadeus.com/register
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

PORT=3000

# Default train data provider: the "Indian Railway IRCTC" API on RapidAPI —
# verifies timetable trains and train schedules against live IRCTC data.
# Subscribe at https://rapidapi.com/rahilkhan224/api/indian-railway-irctc
# (free Basic plan: 50 requests/month) and paste your X-RapidAPI-Key here.
# Server-side only — never put it in public/. Without it, train search uses
# the public erail.in timetable alone.
RAPIDAPI_KEY=
RAPIDAPI_HOST=indian-railway-irctc.p.rapidapi.com
# Uncached IRCTC lookups one train search may spend (each is one request of
# the monthly quota). Blank = 3. 0 = none: searches use the timetable plus
# IRCTC data already cached; train schedule pop-ups still use IRCTC.
# Capped at 10; a value that isn't a whole number falls back to 3.
TRAIN_API_MAX_LOOKUPS_PER_SEARCH=
